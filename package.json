{
  "name": "shutdowner",
  "version": "2.0.0",
  "description": "Odlicza podany czas i wyłącza komputer — wersja z okienkiem (Electron).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "start:dry": "npm run build && electron . --dry-run",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "author": "Ariel Kuźmiński",
  "license": "ISC",
  "build": {
    "productName": "Shutdowner",
    "appId": "scripter.Shutdowner",
    "files": [
      "dist/**",
      "static/**",
      "package.json"
    ],
    "electronLanguages": [
      "pl",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "shutdowner-setup-${version}.${ext}",
      "shortcutName": "Shutdowner"
    },
    "directories": {
      "output": "electron/output",
      "buildResources": "build"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
